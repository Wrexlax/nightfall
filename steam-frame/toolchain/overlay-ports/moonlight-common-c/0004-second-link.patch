@@ -0,0 +1,352 @@
+// Steam Frame (Nightfall): a second network path to the same host.
+//
+// The Steam Frame reaches its PC two ways at once: the home Wi-Fi, and the
+// direct link of the wireless adapter. Steam's own streaming ("Multi-Link")
+// sends its packets over both and uses whichever copy arrives first. This is
+// the client half of the same idea for a stream that passes through Nightfall
+// Meteor on the PC:
+//
+// - the video and audio sockets listen on every address of this device, not
+//   only the one the stream started on (see bindUdpSocket's callers);
+// - their pings, which already go to the host every 500 ms, also go to the
+//   host's address on the second link. A ping carries the 16-byte payload the
+//   host made for this stream alone, so Meteor can tell that the new sender
+//   is this stream and start sending copies of its packets there too;
+// - the RTP queue already drops a packet it has seen, so whichever copy comes
+//   first is used and the other costs nothing but the air time.
+//
+// Nothing happens until LiSetSecondLink() is given an address, and a host that
+// knows nothing of this ignores or mishandles the extra pings: the caller must
+// only set it for a Meteor that says it understands ("second-link").
+
+#include "Limelight-internal.h"
+
+static struct sockaddr_storage secondAddr;
+static volatile bool secondSet;
+// What the second link's pings tell Meteor in extra bytes. The choice: -1 sends
+// no byte (a Meteor that only knows plain pings), 0 both links, 1 the second
+// link first (alone while it holds), 2 no second link (the pings go on so that
+// Meteor knows the choice). Then the number of the last pick made in Meteor's
+// own menu that this side has seen, -1 to send none (meteor/src/proxy.rs,
+// LINK_WANTED).
+static volatile int secondChoice = -1;
+static volatile int secondRev = -1;
+
+// "The second link first" (choice 1), watched from this side. Meteor only
+// hears this device's pings, and a ping is small enough to get through a link
+// that can no longer carry the picture, so Meteor is the last to know that the
+// second link is failing. This side sees it at once: the picture's packets
+// stop, or come with holes. So while the choice is 1 the receive thread keeps
+// a verdict, in short windows:
+//
+// - alone: the second link is carrying the stream well; the pings say 1, and
+//   go ten times a second, so that Meteor too can tell a dead link quickly
+//   (it allows a few pings' worth of silence, whatever their pace).
+// - hold: it is not (or not yet shown to be); the pings say 3, "the second
+//   link first, but both links for now", and Meteor sends copies over the
+//   first link as well. A verdict that changes is sent at once, not at the
+//   next half second.
+//
+// It errs towards hold: a hold costs nothing but air time on the first link.
+// A still screen sends no picture, so "nothing arriving" counts the sound's
+// packets as well, which never stop.
+// Only for a Meteor that knows 3 ("link-hold"): LiSetSecondLinkWatch().
+#define WATCH_WINDOW_MS 100
+// Alone -> hold: this many windows in a row with nothing over the second link
+// (picture or sound), or one window with more than WATCH_LOSS_PERCENT of the
+// picture's packets missing.
+#define WATCH_SILENT_WINDOWS 2
+#define WATCH_LOSS_PERCENT 5
+#define WATCH_LOSS_MIN_PACKETS 4
+// Hold -> alone: this many good windows in a row (picture over the second
+// link, next to none of it missing, and about as much as the first link
+// brought). A window where it fell short starts the count again; a window
+// with next to no picture on either link (a still screen) does neither.
+#define WATCH_STEADY_WINDOWS 30
+#define WATCH_GOOD_MIN_PACKETS 10
+static volatile bool watchEnabled;
+static volatile bool watchAlone;
+static uint64_t watchWindowStart;
+static uint32_t watchFirst, watchSecond, watchMissing;
+// Sound packets over the second link in this window (counted by the audio
+// receive thread; a count that is one short now and then does no harm).
+static volatile uint32_t watchSecondAudio;
+static int watchSilentWindows, watchGoodWindows;
+static bool watchHaveSequence;
+static unsigned short watchLastSequence;
+// For the hold in progress: when it was asked for, and whether the first
+// link's first packet since has been timed yet.
+static uint64_t watchHoldAt;
+static bool watchHoldTimed;
+
+// One byte for every RTP sequence number: which links delivered it.
+#define VIA_FIRST 1
+#define VIA_SECOND 2
+static uint8_t seenVia[65536];
+static SECOND_LINK_STATS stats;
+
+static void applyControl(void);
+
+void LiSetSecondLink(const char* address) {
+    struct sockaddr_in* in = (struct sockaddr_in*)&secondAddr;
+
+    secondSet = false;
+    memset(&stats, 0, sizeof(stats));
+    memset(seenVia, 0, sizeof(seenVia));
+    watchAlone = false;
+    watchWindowStart = 0;
+    watchFirst = watchSecond = watchMissing = 0;
+    watchSecondAudio = 0;
+    watchSilentWindows = watchGoodWindows = 0;
+    watchHaveSequence = false;
+    watchHoldTimed = true;
+    if (address == NULL || address[0] == 0) {
+        applyControl();
+        return;
+    }
+
+    memset(&secondAddr, 0, sizeof(secondAddr));
+    in->sin_family = AF_INET;
+    if (inet_pton(AF_INET, address, &in->sin_addr) != 1) {
+        Limelog("Second link: '%s' is not an IPv4 address\n", address);
+        applyControl();
+        return;
+    }
+    secondSet = true;
+    applyControl();
+}
+
+// The control stream over both links (enet/unix.c, enet_second_link_set).
+static volatile bool controlWanted;
+
+// What ends every control datagram sent over the second link: the 16 bytes
+// the host made for this stream (the same that open the second link for the
+// picture, in the pings), then four letters. Meteor knows a copy by it, takes
+// it off, and passes the datagram on as the same peer's
+// (meteor/src/proxy.rs, control_trailer).
+static const char controlTrailerMark[4] = { 'N', 'F', 'L', '2' };
+
+static void applyControl(void) {
+    struct sockaddr_in first, second;
+    unsigned char trailer[sizeof(VideoPingPayload.payload) + sizeof(controlTrailerMark)];
+
+    if (!controlWanted || !secondSet || RemoteAddr.ss_family != AF_INET || ControlPortNumber == 0 ||
+        VideoPingPayload.payload[0] == 0) {
+        enet_second_link_set(NULL, NULL, NULL, 0);
+        return;
+    }
+    memcpy(&first, &RemoteAddr, sizeof(first));
+    first.sin_port = htons(ControlPortNumber);
+    memcpy(&second, &secondAddr, sizeof(second));
+    second.sin_port = htons(ControlPortNumber);
+    memcpy(trailer, VideoPingPayload.payload, sizeof(VideoPingPayload.payload));
+    memcpy(trailer + sizeof(VideoPingPayload.payload), controlTrailerMark, sizeof(controlTrailerMark));
+    enet_second_link_set((struct sockaddr*)&first, (struct sockaddr*)&second, trailer, sizeof(trailer));
+}
+
+void LiSetSecondLinkControl(bool enabled) {
+    controlWanted = enabled;
+    applyControl();
+}
+
+void secondLinkStreamStarting(void) {
+    LiSetSecondLink(NULL);
+}
+
+void secondLinkControlStarting(void) {
+    controlWanted = false;
+    enet_second_link_set(NULL, NULL, NULL, 0);
+}
+
+void LiSetSecondLinkWatch(bool enabled) {
+    watchEnabled = enabled;
+    if (!enabled) {
+        watchAlone = false;
+    }
+}
+
+void LiSetSecondLinkChoice(int choice, int rev) {
+    secondChoice = choice < 0 ? -1 : (choice > 2 ? 2 : choice);
+    secondRev = rev < 0 ? -1 : (rev & 0xff);
+}
+
+// The ping to send over the second link: the stream's own ping, then the
+// extra bytes that are to be sent. "out" must hold pingLength + 2 bytes.
+// Returns the length to send.
+int secondLinkPing(const void* ping, int pingLength, char* out) {
+    int choice = secondChoice;
+    int rev = secondRev;
+
+    memcpy(out, ping, pingLength);
+    if (choice < 0) {
+        return pingLength;
+    }
+    // The second link first, but not alone until it has shown itself steady.
+    out[pingLength] = (char)(choice == 1 && watchEnabled && !watchAlone ? 3 : choice);
+    if (rev < 0) {
+        return pingLength + 1;
+    }
+    out[pingLength + 1] = (char)rev;
+    return pingLength + 2;
+}
+
+bool secondLinkAddress(LC_SOCKADDR* addr, unsigned short port) {
+    // Only where the stream itself is IPv4, so that the one socket can send
+    // to both addresses.
+    if (!secondSet || RemoteAddr.ss_family != AF_INET) {
+        return false;
+    }
+    memcpy(addr, &secondAddr, sizeof(*addr));
+    SET_PORT(addr, port);
+    return true;
+}
+
+void secondLinkCountVideo(const struct sockaddr_storage* from, unsigned short sequenceNumber) {
+    uint8_t via;
+    uint8_t* seen;
+    uint8_t* old;
+
+    if (!secondSet || from->ss_family != AF_INET) {
+        return;
+    }
+
+    via = ((const struct sockaddr_in*)from)->sin_addr.s_addr ==
+          ((const struct sockaddr_in*)&secondAddr)->sin_addr.s_addr ? VIA_SECOND : VIA_FIRST;
+    if (via == VIA_SECOND) {
+        stats.secondLinkPackets++;
+        watchSecond++;
+        // Holes in the second link's own numbering: packets it lost.
+        if (watchHaveSequence) {
+            unsigned short gap = (unsigned short)(sequenceNumber - watchLastSequence - 1);
+            if (gap > 0 && gap < 2000) {
+                watchMissing += gap;
+                stats.secondLinkMissing += gap;
+            }
+            if (gap < 32768) {
+                watchLastSequence = sequenceNumber;
+            }
+        }
+        else {
+            watchHaveSequence = true;
+            watchLastSequence = sequenceNumber;
+        }
+    }
+    else {
+        stats.firstLinkPackets++;
+        watchFirst++;
+        if (!watchHoldTimed) {
+            // How long the first link took to answer the last hold.
+            watchHoldTimed = true;
+            stats.lastHoldAnsweredMs = (uint32_t)(PltGetMillis() - watchHoldAt) + 1;
+        }
+    }
+
+    seen = &seenVia[sequenceNumber];
+    if (*seen == 0) {
+        stats.packets++;
+        if (via == VIA_SECOND) {
+            // The second link's copy is the one that will be used.
+            stats.secondLinkFirst++;
+        }
+    }
+    *seen |= via;
+
+    // The number half the range away is some seconds old: both its copies
+    // have arrived by now if they ever will. Settle it and free its place.
+    old = &seenVia[(unsigned short)(sequenceNumber + 32768)];
+    if (*old == (VIA_FIRST | VIA_SECOND)) {
+        stats.bothLinks++;
+    }
+    else if (*old == VIA_FIRST) {
+        stats.onlyFirstLink++;
+    }
+    else if (*old == VIA_SECOND) {
+        stats.onlySecondLink++;
+    }
+    *old = 0;
+}
+
+void secondLinkHeardAudio(const struct sockaddr_storage* from) {
+    if (secondSet && from->ss_family == AF_INET &&
+        ((const struct sockaddr_in*)from)->sin_addr.s_addr == ((const struct sockaddr_in*)&secondAddr)->sin_addr.s_addr) {
+        watchSecondAudio++;
+    }
+}
+
+// Called by the video receive thread after every packet and every time its
+// wait for one runs out (100 ms), so a link that has gone silent is noticed
+// too. Closes a window when one is due and gives the verdict. Returns true
+// when a second-link ping is to be sent now: the verdict changed, or the
+// second link is alone (its pings then go at this pace).
+bool secondLinkWatch(void) {
+    uint64_t now;
+    bool silent, lossy, good, bad, was;
+
+    if (!secondSet || !watchEnabled || secondChoice != 1) {
+        watchAlone = false;
+        watchWindowStart = 0;
+        stats.alone = 0;
+        return false;
+    }
+
+    now = PltGetMillis();
+    if (watchWindowStart == 0) {
+        watchWindowStart = now;
+        watchFirst = watchSecond = watchMissing = 0;
+        watchSecondAudio = 0;
+        watchSilentWindows = watchGoodWindows = 0;
+        return false;
+    }
+    if (now - watchWindowStart < WATCH_WINDOW_MS) {
+        return false;
+    }
+
+    silent = watchSecond == 0 && watchSecondAudio == 0;
+    lossy = watchMissing >= WATCH_LOSS_MIN_PACKETS &&
+            watchMissing * 100 > (watchSecond + watchMissing) * WATCH_LOSS_PERCENT;
+    good = watchSecond >= WATCH_GOOD_MIN_PACKETS && watchMissing * 50 <= watchSecond &&
+           watchSecond * 10 >= watchFirst * 7;
+    bad = !good && (watchFirst >= WATCH_GOOD_MIN_PACKETS || watchMissing >= 2);
+    was = watchAlone;
+
+    if (watchAlone) {
+        watchSilentWindows = silent ? watchSilentWindows + 1 : 0;
+        if (lossy || watchSilentWindows >= WATCH_SILENT_WINDOWS) {
+            watchAlone = false;
+            watchGoodWindows = 0;
+            stats.holds++;
+            stats.lastHoldReason = lossy ? 2 : 1;
+            stats.lastHoldMissing = watchMissing;
+            stats.lastHoldAnsweredMs = 0;
+            watchHoldAt = now;
+            // Timed only if the first link was not already bringing copies.
+            watchHoldTimed = watchFirst > 0;
+        }
+    }
+    else if (good) {
+        if (++watchGoodWindows >= WATCH_STEADY_WINDOWS) {
+            watchAlone = true;
+            watchSilentWindows = 0;
+            stats.alones++;
+        }
+    }
+    else if (bad) {
+        watchGoodWindows = 0;
+    }
+
+    stats.alone = watchAlone ? 1 : 0;
+    watchWindowStart = now;
+    watchFirst = watchSecond = watchMissing = 0;
+    watchSecondAudio = 0;
+    return was != watchAlone || watchAlone;
+}
+
+void LiGetSecondLinkStats(SECOND_LINK_STATS* out) {
+    unsigned long long first = 0, second = 0;
+
+    // Read while the receive thread counts: a figure may be one packet behind.
+    memcpy(out, &stats, sizeof(stats));
+    enet_second_link_counts(&first, &second);
+    out->controlFirstLink = first;
+    out->controlSecondLink = second;
+}
