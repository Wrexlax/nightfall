diff --git a/enet/unix.c b/enet/unix.c
index f5563c0..b0c5bf8 100644
--- a/enet/unix.c
+++ b/enet/unix.c
@@ -559,6 +559,77 @@ enet_socket_destroy (ENetSocket socket)
       close (socket);
 }
 
+/* Steam Frame (Nightfall): one peer reached over two network paths at once.
+ *
+ * The control stream is an ENet connection to one address. With a second
+ * path to the same host (moonlight-common-c, SecondLink.c) every datagram
+ * for that peer is sent to its address on the second path as well, and a
+ * datagram that arrives from there is handed up as if it had come from the
+ * first: ENet numbers what it sends, so whichever copy comes second is
+ * dropped as already seen, and either path can go silent without the
+ * connection noticing. The host must send its datagrams over both paths too
+ * and take ours from either as one peer (Nightfall Meteor does); anything
+ * else would see two peers. So that it can tell, each copy sent over the
+ * second path ends with a few bytes the caller supplies (the trailer), which
+ * name the stream; the host takes them off again. What the host sends over
+ * the second path has no trailer: it is known by where it comes from.
+ *
+ * ENet here follows a peer to whatever address its last datagram came from,
+ * and answers from the local address it arrived on (see
+ * enet_protocol_handle_incoming_commands); so for a datagram from the second
+ * path both are put back to the first path's, or the connection would hop
+ * between the two. */
+static struct sockaddr_storage secondLinkFirst, secondLinkSecond;
+static socklen_t secondLinkFirstLength, secondLinkSecondLength;
+static volatile int secondLinkSet;
+static ENetAddress secondLinkFirstLocal;
+static unsigned long long secondLinkFromFirst, secondLinkFromSecond;
+static unsigned char secondLinkTrailer [32];
+static size_t secondLinkTrailerLength;
+
+static int
+enet_second_link_same (const struct sockaddr_storage * a, const struct sockaddr_storage * b)
+{
+    const struct sockaddr_in * a4 = (const struct sockaddr_in *) a;
+    const struct sockaddr_in * b4 = (const struct sockaddr_in *) b;
+
+    return a -> ss_family == AF_INET && b -> ss_family == AF_INET &&
+           a4 -> sin_addr.s_addr == b4 -> sin_addr.s_addr && a4 -> sin_port == b4 -> sin_port;
+}
+
+/* The peer's address on the first path and on the second, both IPv4 with
+ * their ports, and the trailer for what is sent over the second (up to 32
+ * bytes); second NULL stops it. Clears the counts. */
+void
+enet_second_link_set (const struct sockaddr * first, const struct sockaddr * second, const void * trailer, size_t trailerLength)
+{
+    secondLinkSet = 0;
+    secondLinkFromFirst = secondLinkFromSecond = 0;
+    memset (& secondLinkFirstLocal, 0, sizeof (secondLinkFirstLocal));
+    if (first == NULL || second == NULL || first -> sa_family != AF_INET || second -> sa_family != AF_INET ||
+        trailerLength > sizeof (secondLinkTrailer))
+      return;
+
+    if (trailerLength > 0)
+      memcpy (secondLinkTrailer, trailer, trailerLength);
+    secondLinkTrailerLength = trailerLength;
+
+    memset (& secondLinkFirst, 0, sizeof (secondLinkFirst));
+    memset (& secondLinkSecond, 0, sizeof (secondLinkSecond));
+    memcpy (& secondLinkFirst, first, sizeof (struct sockaddr_in));
+    memcpy (& secondLinkSecond, second, sizeof (struct sockaddr_in));
+    secondLinkFirstLength = secondLinkSecondLength = sizeof (struct sockaddr_in);
+    secondLinkSet = 1;
+}
+
+/* Datagrams received over each path since enet_second_link_set(). */
+void
+enet_second_link_counts (unsigned long long * fromFirst, unsigned long long * fromSecond)
+{
+    * fromFirst = secondLinkFromFirst;
+    * fromSecond = secondLinkFromSecond;
+}
+
 int
 enet_socket_send (ENetSocket socket,
                   const ENetAddress * peerAddress,
@@ -674,6 +745,28 @@ enet_socket_send (ENetSocket socket,
     }
 
     sentLength = sendmsg (socket, & msgHdr, MSG_NOSIGNAL);
+
+    /* Steam Frame (Nightfall): and to the peer's address on the second path.
+       No local address is asked for: the route there picks it. Whether this
+       copy goes out or not is not the connection's business. */
+    if (secondLinkSet && peerAddress != NULL && bufferCount < 64 &&
+        enet_second_link_same (& peerAddress -> address, & secondLinkFirst))
+    {
+        struct msghdr second;
+        struct iovec parts [65];
+
+        /* The same buffers, then the trailer. */
+        memcpy (parts, buffers, bufferCount * sizeof (struct iovec));
+        parts [bufferCount].iov_base = secondLinkTrailer;
+        parts [bufferCount].iov_len = secondLinkTrailerLength;
+
+        memset (& second, 0, sizeof (second));
+        second.msg_name = (void *) & secondLinkSecond;
+        second.msg_namelen = secondLinkSecondLength;
+        second.msg_iov = parts;
+        second.msg_iovlen = bufferCount + (secondLinkTrailerLength > 0 ? 1 : 0);
+        sendmsg (socket, & second, MSG_NOSIGNAL);
+    }
 #endif
 
     if (sentLength == -1)
@@ -814,6 +907,31 @@ enet_socket_receive (ENetSocket socket,
 #endif
     }
 
+    /* Steam Frame (Nightfall): a datagram from the peer's address on the
+       second path is handed up as one from the first (see above). */
+    if (secondLinkSet && peerAddress != NULL)
+    {
+        /* By its machine address alone: the host may answer over the second
+           path from another port than the one it listens on (Meteor does). */
+        if (peerAddress -> address.ss_family == AF_INET &&
+            ((const struct sockaddr_in *) & peerAddress -> address) -> sin_addr.s_addr ==
+            ((const struct sockaddr_in *) & secondLinkSecond) -> sin_addr.s_addr)
+        {
+            secondLinkFromSecond ++;
+            memcpy (& peerAddress -> address, & secondLinkFirst, sizeof (secondLinkFirst));
+            peerAddress -> addressLength = secondLinkFirstLength;
+            if (localAddress != NULL)
+              * localAddress = secondLinkFirstLocal;
+        }
+        else
+        if (enet_second_link_same (& peerAddress -> address, & secondLinkFirst))
+        {
+            secondLinkFromFirst ++;
+            if (localAddress != NULL)
+              secondLinkFirstLocal = * localAddress;
+        }
+    }
+
     return recvLength;
 #endif
 }
