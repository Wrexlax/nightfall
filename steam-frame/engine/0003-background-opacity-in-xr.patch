 		clear_color = p_default_bg_color;
 	}
 
+	// Nightfall: in the stereo (XR) picture, a transparent background drawn
+	// with a custom background colour keeps that colour's opacity. The 3D
+	// buffer has 2 bits of alpha, so the background is still cleared to fully
+	// transparent below; the tonemapper applies the opacity instead, as it
+	// writes to the 8-bit render target. Everything else behaves as in stock
+	// Godot, which drops the opacity.
+	p_render_data->transparent_bg_alpha = 0.0f;
+	if (p_render_data->transparent_bg && p_render_data->scene_data->view_count > 1 && is_environment(p_render_data->environment) && environment_get_background(p_render_data->environment) == RSE::ENV_BG_COLOR && get_debug_draw_mode() != RSE::VIEWPORT_DEBUG_DRAW_OVERDRAW) {
+		p_render_data->transparent_bg_alpha = CLAMP(environment_get_bg_color(p_render_data->environment).a, 0.0f, 1.0f);
+	}
+
 	// We don't have access to any rendered buffers but we may be able to effect mesh data...
 	_process_compositor_effects(RSE::COMPOSITOR_EFFECT_CALLBACK_TYPE_PRE_OPAQUE, p_render_data);
 
